{
  "name": "tachyon-website",
  "version": "26.36.01",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "bundle": "bun run content && bun ../scripts/run-site.mjs bundle",
    "dev": "bun run content && bun ../scripts/run-site.mjs preview",
    "styles": "node scripts/build-styles.mjs",
    "styles:check": "node scripts/build-styles.mjs --check",
    "duvay": "node scripts/build-duvay.mjs",
    "test": "bun test",
    "verify:snippets": "node scripts/verify-snippets.mjs",
    "coverage:languages": "node scripts/language-coverage.mjs",
    "check:responsive": "node scripts/check-responsive.mjs"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.1",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  }
}
