{
  "name": "@d31ma/tachyon",
  "version": "26.36.01",
  "description": "Tooling and qualification dependencies for the Tachyon Rust framework",
  "author": "Chidelma",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "typecheck": "bun check -p jsconfig.json && bun check -p jsconfig.release.json && bun run typecheck:types",
    "typecheck:types": "bun check -p types/tsconfig.json && bun check -p types/tsconfig.json --experimentalDecorators && bun check -p types/tsconfig.routes.json",
    "test:website": "bun --cwd website test",
    "test:website-browser": "node scripts/website-browser-test.mjs",
    "test:phase3-browser": "node scripts/phase3-browser-test.mjs",
    "test:hot-update-browser": "node scripts/hot-update-browser-test.mjs",
    "test:phase4-macos": "node scripts/phase4-macos-test.mjs",
    "test:compat": "node scripts/compat/differential.mjs",
    "test:standalone-rust": "node scripts/compat/standalone-rust.mjs",
    "test:events-browser": "node scripts/events-browser-test.mjs",
    "test:service-worker-browser": "node scripts/service-worker-browser-test.mjs",
    "test:cached-client-browser": "node scripts/cached-client-browser-test.mjs",
    "test:window-controls-browser": "node scripts/window-controls-browser-test.mjs",
    "test:window-grant-macos": "node scripts/window-grant-macos-test.mjs",
    "test:island-expression": "node scripts/island-expression-test.mjs",
    "test:runtime-browser": "node scripts/runtime-browser-test.mjs",
    "test:safe-html-browser": "node scripts/safe-html-browser-test.mjs",
    "test:behavior-runtime": "node scripts/behavior-runtime-test.mjs",
    "test:behavior-browser": "node scripts/behavior-browser-test.mjs",
    "test:tac-client": "node scripts/tac-client-test.mjs",
    "test:application-events": "node scripts/application-events-test.mjs",
    "test:tac-events": "node scripts/tac-events-test.mjs",
    "test:behavior-jvm": "node scripts/behavior-jvm-test.mjs",
    "test:behavior-native-runtime": "node scripts/behavior-native-runtime-test.mjs cs swift",
    "test:storage-browser": "node scripts/storage-browser-test.mjs",
    "test:web-apis-browser": "node scripts/web-apis-browser-test.mjs",
    "test:web-components-browser": "node scripts/web-components-browser-test.mjs",
    "test:authored-node-browser": "node scripts/authored-node-browser-gate.mjs",
    "test:scaffold-browser": "node scripts/scaffold-browser-gate.mjs",
    "test:native-companion": "node scripts/native/companion-test.mjs"
  },
  "keywords": [
    "tachyon",
    "rust",
    "framework",
    "api",
    "polyglot",
    "file-system-routing",
    "native-ui",
    "web-framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d31ma/Tachyon.git"
  },
  "homepage": "https://tachyon.del.ma",
  "bugs": {
    "url": "https://github.com/d31ma/Tachyon/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.1",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2"
  }
}
