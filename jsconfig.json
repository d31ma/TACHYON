{
  "compilerOptions": {
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "/models/*": ["./website/client/models/*"],
      "/shared/*": ["./website/client/shared/*"]
    },
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun-types", "@types/node"],
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": false
  },
  "include": [
    "types/**/*.d.ts",
    "website/.tachyon/types/client",
    "website/**/*.d.ts",
    "website/**/*.js",
    "website/**/*.ts"
  ],
  "exclude": ["**/*.as.ts", "website/content", "website/dist", "website/dist-debug", "website/node_modules*", "website/client/shared/assets/duvay/**/*.js"]
}
