{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tachyon.del.ma/schema/handler-protocol/v1",
  "title": "Tachyon Handler Protocol v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/cancel"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "headers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
      },
      "additionalProperties": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "maxProperties": 128
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "utf8",
            "base64"
          ]
        },
        "data": {
          "type": "string",
          "maxLength": 16777216
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "kind",
        "request_id",
        "operation",
        "route",
        "method",
        "headers"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "kind": {
          "const": "request"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "route": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 2048
        },
        "target": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 8192
        },
        "method": {
          "enum": [
            "DELETE",
            "GET",
            "HEAD",
            "OPTIONS",
            "PATCH",
            "POST",
            "PUT"
          ]
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "body": {
          "$ref": "#/$defs/body"
        },
        "parameters": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "arguments": {
          "type": "array",
          "maxItems": 64
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "kind",
        "request_id",
        "status",
        "headers"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "kind": {
          "const": "response"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "body": {
          "$ref": "#/$defs/body"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^TY[0-9]{4}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "retryable": {
              "type": "boolean"
            },
            "violations": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "rule"],
                "properties": {
                  "field": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^(?:[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*|\\[(?:0|[1-9][0-9]*)\\])*)?$"
                  },
                  "rule": {
                    "enum": ["Checked", "Required", "NotEmpty", "Length", "Min", "Max"]
                  }
                }
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "body"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "body"
            ]
          }
        }
      ]
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "kind",
        "request_id"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "kind": {
          "const": "cancel"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
