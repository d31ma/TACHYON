
#[allow(dead_code)]
mod __yon_built_in_errors {
    use super::{Json, YonRead};

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct BrokenRule {
        pub field: String,
        pub rule: String,
    }

    impl BrokenRule {
        fn yon_read(value: &Json) -> Self {
            Self { field: value.get("field").text(), rule: value.get("rule").text() }
        }
    }

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct NotSignedIn {
        pub reference: String,
    }

    impl NotSignedIn {
        pub const STATUS: u16 = 401;

        #[must_use]
        pub fn status(&self) -> u16 {
            Self::STATUS
        }
    }

    impl std::fmt::Display for NotSignedIn {
        fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
            formatter.write_str("NotSignedIn")
        }
    }

    impl std::error::Error for NotSignedIn {}

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct RoleMissing {
        pub reference: String,
    }

    impl RoleMissing {
        pub const STATUS: u16 = 403;

        #[must_use]
        pub fn status(&self) -> u16 {
            Self::STATUS
        }
    }

    impl std::fmt::Display for RoleMissing {
        fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
            formatter.write_str("RoleMissing")
        }
    }

    impl std::error::Error for RoleMissing {}

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct IdentityCheckFailed {
        pub reference: String,
    }

    impl IdentityCheckFailed {
        pub const STATUS: u16 = 500;

        #[must_use]
        pub fn status(&self) -> u16 {
            Self::STATUS
        }
    }

    impl std::fmt::Display for IdentityCheckFailed {
        fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
            formatter.write_str("IdentityCheckFailed")
        }
    }

    impl std::error::Error for IdentityCheckFailed {}

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct RequestRejected {
        pub reference: String,
        pub part: String,
        pub field: String,
        pub message: String,
    }

    impl RequestRejected {
        pub const STATUS: u16 = 400;

        #[must_use]
        pub fn status(&self) -> u16 {
            Self::STATUS
        }
    }

    impl std::fmt::Display for RequestRejected {
        fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
            formatter.write_str("RequestRejected")
        }
    }

    impl std::error::Error for RequestRejected {}

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct BodyTooLarge {
        pub reference: String,
        pub limit_bytes: u64,
    }

    impl BodyTooLarge {
        pub const STATUS: u16 = 413;

        #[must_use]
        pub fn status(&self) -> u16 {
            Self::STATUS
        }
    }

    impl std::fmt::Display for BodyTooLarge {
        fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
            formatter.write_str("BodyTooLarge")
        }
    }

    impl std::error::Error for BodyTooLarge {}

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct CheckRejected {
        pub reference: String,
        pub violations: Vec<BrokenRule>,
        pub truncated: bool,
    }

    impl CheckRejected {
        pub const STATUS: u16 = 422;

        #[must_use]
        pub fn status(&self) -> u16 {
            Self::STATUS
        }
    }

    impl std::fmt::Display for CheckRejected {
        fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
            formatter.write_str("CheckRejected")
        }
    }

    impl std::error::Error for CheckRejected {}

    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct UnexpectedError {
        pub reference: String,
    }

    impl UnexpectedError {
        pub const STATUS: u16 = 500;

        #[must_use]
        pub fn status(&self) -> u16 {
            Self::STATUS
        }
    }

    impl std::fmt::Display for UnexpectedError {
        fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
            formatter.write_str("UnexpectedError")
        }
    }

    impl std::error::Error for UnexpectedError {}

    pub fn __yon_built_in_error__(value: &Json) -> Option<Box<dyn std::error::Error>> {
        let reference = value.get("reference").text();
        let error: Box<dyn std::error::Error> = match value.get("type").text().as_str() {
            "NotSignedIn" => Box::new(NotSignedIn { reference }),
            "RoleMissing" => Box::new(RoleMissing { reference }),
            "IdentityCheckFailed" => Box::new(IdentityCheckFailed { reference }),
            "RequestRejected" => Box::new(RequestRejected {
                reference,
                part: value.get("part").text(),
                field: value.get("field").text(),
                message: value.get("message").text(),
            }),
            "BodyTooLarge" => Box::new(BodyTooLarge {
                reference,
                limit_bytes: u64::read(value.get("limitBytes")),
            }),
            "CheckRejected" => Box::new(CheckRejected {
                reference,
                violations: value.get("violations").items().iter().map(BrokenRule::yon_read).collect(),
                truncated: value.get("truncated") == &Json::Bool(true),
            }),
            "UnexpectedError" => Box::new(UnexpectedError { reference }),
            _ => return None,
        };
        Some(error)
    }
}
