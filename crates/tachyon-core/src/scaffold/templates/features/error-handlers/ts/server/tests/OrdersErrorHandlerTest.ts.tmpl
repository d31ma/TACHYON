@Test(OrdersTestSetup, {"partition":"tests"})
export default class OrdersErrorHandlerTest {
  async testMissingAnswersWithAProblem(): Promise<void> {
    const problem = new OrdersErrorHandler().missing(new OrderNotFound('order 42'));
    if (problem.code !== 'order-not-found') throw Error(`code is ${problem.code}`);
  }
}
