@Test(NewsTestSetup, {"partition":"tests"})
export default class NewsControllerTest {
  @Fake
  applicationEventPublisher!: ApplicationEventPublisher;

  async testPostNewsPublishesTheItem(): Promise<void> {
    const published: unknown[] = [];
    this.applicationEventPublisher = { publishEvent: (item: unknown) => { published.push(item); } } as unknown as ApplicationEventPublisher;
    this.construct(NewsController).postNews({ text: 'Hello' });
    Assert.equals(1, published.length);
  }
}
