@Test(NoteTestSetup, {"partition":"tests"})
export default class NoteStoreTest {
  @Fake
  dataSource!: DataSource;

  async testCountNotesRunsOneQuery(): Promise<void> {
    const queries: string[] = [];
    this.dataSource = { query: async (sql: string) => { queries.push(sql); return []; } } as unknown as DataSource;
    await this.construct(NoteStore).countNotes();
    Assert.equals(1, queries.length);
  }
}
