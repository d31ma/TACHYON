@Test(NoteTestSetup, {"partition":"tests"})
export default class NoteControllerTest {
  @Fake
  noteService!: NoteService;

  async testGetNotesAsksTheService(): Promise<void> {
    this.noteService = { countNotes: async () => [{ notes: 3 }] } as unknown as NoteService;
