@Test(NoteTestSetup, {"partition":"tests"})
export default class NoteControllerTest {
  @Fake
  noteStore: NoteStore;

  async testGetNotesAsksTheStore(): Promise<void> {
    this.noteStore = { countNotes: async () => [{ notes: 3 }] } as unknown as NoteStore;
    const rows = await this.construct(NoteController).getNotes();
    if (rows.length !== 1) throw Error(`rows are ${JSON.stringify(rows)}`);
  }
}
