@Test(ChatTestSetup, {"partition":"tests"})
export default class ChatControllerTest {
  async testOnOpenWelcomesTheSession() {
    const sent = []
    await this.construct(ChatController).onOpen({ send: async (message) => sent.push(message) })
    Assert.equals('Welcome to the room', sent[0].text)
  }

  async testOnMessageSendsToEveryOpenSession() {
    const sent = []
    const peer = { send: async (message) => sent.push(message) }
    const session = { openSessions: async () => [peer, peer] }
    await this.construct(ChatController).onMessage(session, { text: 'Hi' })
    Assert.equals(2, sent.length)
  }
}
