@Test(ChatTestSetup, {"partition":"tests"})
export default class ChatControllerTest {
  async testOnOpenWelcomesTheSession() {
    /** @type {object[]} */
    const sent = []
    /** @type {SocketSession} */
    const session = { id: 'one', send: async (message) => { sent.push(message) }, close: async () => {}, openSessions: async () => [] }
    await this.construct(ChatController).onOpen(session)
    Assert.equals(1, sent.length)
  }

  async testOnMessageSendsToEveryOpenSession() {
    /** @type {object[]} */
    const sent = []
    /** @type {SocketPeer} */
    const peer = { id: 'peer', send: async (message) => { sent.push(message) } }
    /** @type {SocketSession} */
    const session = { ...peer, close: async () => {}, openSessions: async () => [peer, peer] }
    await this.construct(ChatController).onMessage(session, { text: 'Hi' })
    Assert.equals(2, sent.length)
  }
}
