@Test(ChatTestSetup, {"partition":"tests"})
export default class ChatControllerTest {
  async testOnOpenWelcomesTheSession(): Promise<void> {
    const sent: unknown[] = [];
    const session = { send: async (message: unknown) => { sent.push(message); } } as unknown as SocketSession;
    await this.construct(ChatController).onOpen(session);
    Assert.equals(1, sent.length);
  }

  async testOnMessageSendsToEveryOpenSession(): Promise<void> {
    const sent: unknown[] = [];
    const peer = { send: async (message: unknown) => { sent.push(message); } };
    const session = { openSessions: async () => [peer, peer] } as unknown as SocketSession;
    await this.construct(ChatController).onMessage(session, { text: 'Hi' });
    Assert.equals(2, sent.length);
  }
}
