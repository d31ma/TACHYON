@Test(TickTestSetup, {"partition":"tests"})
export default class TickServiceTest {
  async testAddTickKeepsTheTick(): Promise<void> {
    const service = new TickService()
    service.addTick({ level: 3 })
    if (service.ticks.length !== 1) throw Error(`ticks are ${JSON.stringify(service.ticks)}`)
  }
}
