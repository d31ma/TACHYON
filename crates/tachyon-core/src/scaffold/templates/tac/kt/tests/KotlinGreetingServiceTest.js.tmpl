@Test(KotlinGreetingTestSetup, {"partition":"tests"})
export default class KotlinGreetingServiceTest {
  async testGreetChangesTheMessageOnTheWeb() {
    const greeting = new KotlinGreetingService()
    greeting.greet()
    if (greeting.message !== 'Kotlin says hello again.') throw Error(`message is ${greeting.message}`)
  }
}
